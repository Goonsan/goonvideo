---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
    title="Contact – Vidéaste à Nantes | Towa Film"
    description="Discutons de votre projet vidéo : mariage, clip musical ou film d'entreprise. Olivier Gonnet, vidéaste à Nantes, vous répond sous 24h."
    breadcrumbs={[{ name: 'Contact', url: '/contact/' }]}
>
    <Header />
    <main id="main-content" class="contact-page">
        <section class="contact-container">
            <div class="contact-info">
                <h1>Discutons de votre projet</h1>
                <p>Besoin d'un film de mariage, d'un clip ou d'une vidéo corporate ? Je réponds à toutes vos questions sous 24h.</p>
                
                <div class="info-list">
                    <div class="info-item">
                        <span class="info-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
                        <div>
                            <strong>Zone d'intervention</strong>
                            <p>Nantes, Loire-Atlantique &amp; Grand Ouest</p>
                        </div>
                    </div>
                    <!--<div class="info-item">
                        <span>📞</span>
                        <div>
                            <strong>Téléphone</strong>
                            <p>06 44 23 79 89</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <span>✉️</span>
                        <div>
                            <strong>Email</strong>
                            <p>oliviergonnet.video@gmail.com</p>
                        </div>
                    </div>
                    -->
                </div>
            </div>

            <div class="contact-action-card">
                <div class="card-content">
                    <h2>Prêt à passer à l'action ?</h2>
                    <p>Cliquez ci-dessous pour m'envoyer un mail directement. N'hésitez pas à me décrire brièvement votre projet et vos dates.</p>
                    
                    <a href="mailto:oliviergonnet.video@gmail.com?subject=Demande de projet vidéo - TOWA FILM" class="btn-primary main-btn">
                        Envoyer un message
                    </a>
                    <!--
                    <span class="or-text">OU</span>
                    
                    <a href="tel:0644237989" class="secondary-link">M'appeler directement</a>
                    -->
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style lang="scss">
    @use "../styles/variables" as vars;

    .contact-page { padding-top: 150px; min-height: 80vh; }
    .contact-container { 
        max-width: 1100px; 
        margin: 0 auto; 
        display: grid; 
        grid-template-columns: 1fr 1fr; 
        gap: 4rem; 
        padding: 0 2rem;
    }

    h1 { font-size: 3rem; margin: 0 0 1.5rem; }
    .contact-info p { font-size: 1.05rem; color: vars.$muted; line-height: 1.8; }

    .info-list { display: flex; flex-direction: column; gap: 2rem; margin-top: 3rem; }
    .info-item { display: flex; gap: 1.25rem; align-items: center; }
    // Picto fin au trait, dans un cercle discret
    .info-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 3.25rem;
        height: 3.25rem;
        border: 1px solid vars.$line;
        border-radius: 50%;
    }
    .info-item strong { display: block; @include vars.label; font-size: 0.72rem; color: vars.$muted; margin-bottom: 0.3rem; }
    .info-item p { margin: 0; font-size: 1.1rem; font-weight: 500; color: white; }

    /* La carte d'action */
    .contact-action-card { 
        background-color: vars.$charcoal-soft;
        padding: 3rem; 
        border-radius: 2px; 
        border: 1px solid vars.$line;
        text-align: center;
        display: flex;
        align-items: center;
    }
    .card-content h2 { font-size: 2.2rem; margin: 0 0 1rem; color: #fff; }
    .card-content p { margin-bottom: 2rem; color: vars.$muted; line-height: 1.7; }

    .main-btn { display: block; padding: 1.1rem; }

    .or-text { display: block; margin: 1.5rem 0; font-size: 0.8rem; opacity: 0.5; }
    .secondary-link { @include vars.content-link; font-weight: 500; }

    /* --- RESPONSIVE MOBILE --- */
    @media (max-width: 768px) {
        .contact-page { padding-top: 120px; }
        .contact-container {
            display: block;
            padding: 0 1.5rem;
        }
        h1 { font-size: 2.4rem; }
        .contact-action-card { margin-top: 3rem; padding: 2.25rem 1.5rem; }
    }
</style>
