---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
    title="Demander un devis – Vidéaste à Nantes | Towa Film"
    description="Obtenez un devis personnalisé pour votre film de mariage, clip musical ou vidéo d'entreprise avec Olivier Gonnet, vidéaste à Nantes. Réponse sous 48h."
    breadcrumbs={[{ name: 'Demander un devis', url: '/devis/' }]}
>
    <Header />
    <main id="main-content" class="devis-page">
        <section class="container">
            <div class="intro">
                <h1>Votre projet commence ici</h1>
                <p>Pour vous proposer un devis précis et adapté à votre budget, j'ai besoin de quelques détails sur votre vision.</p>
            </div>

            <div class="steps">
                <div class="step">
                    <span class="number">1</span>
                    <h3>Le Brief</h3>
                    <p>On discute de vos besoins (Mariage, Clip, Entreprise).</p>
                </div>
                <div class="step">
                    <span class="number">2</span>
                    <h3>L'Analyse</h3>
                    <p>Je reviens vers vous avec une proposition tarifaire sous 48h.</p>
                </div>
                <div class="step">
                    <span class="number">3</span>
                    <h3>Le Tournage</h3>
                    <p>On fixe les dates et on donne vie à vos images.</p>
                </div>
            </div>

             
            <div class="action-box">
                <h3>Un projet Clip, Sport ou Entreprise ?</h3>
                <p>Pour toute demande hors mariage, contactez-moi directement par mail :</p>
                <a href="mailto:contact@towafilm.fr?subject=Demande de devis personnalisé" class="btn-primary">
                    ENVOYER UN MAIL DIRECT
                </a>
            </div>

            <div class="form-container">
                <span class="badge">Spécial Mariage</span>
                <h2>Préparons ensemble votre film de mariage</h2>
                <p>Pour que je puisse comprendre l'ambiance de votre union, merci de remplir ce questionnaire détaillé :</p>

                <div id="gform-wrapper" class="gform-wrapper">
                    <button type="button" id="load-gform" class="btn-primary">Charger le formulaire</button>
                    <p class="gform-note">Formulaire hébergé par Google Forms — ne se charge qu'après votre clic.</p>
                </div>
            </div>

            <script is:inline>
            document.getElementById('load-gform')?.addEventListener('click', function () {
                document.getElementById('gform-wrapper').innerHTML =
                    '<iframe title="Formulaire de devis mariage" src="https://docs.google.com/forms/d/e/1FAIpQLSf-OMgKnKGz7c8TbyxwQGwyG83e3WEvZFTBcmmv4LYZu-nf5A/viewform?embedded=true" width="100%" height="5201" frameborder="0" marginheight="0" marginwidth="0">Chargement…</iframe>';
            });
            </script>

        </section>
    </main>
    <Footer />
</Layout>

<style lang="scss">
    @use "../styles/variables" as vars;

    .devis-page {
        padding: 150px 1rem 80px;
        text-align: center;
    }

    .container { max-width: 900px; margin: 0 auto; }

    h1 { font-size: 3rem; margin: 0 0 1rem; }
    h2 { font-size: 2.2rem; margin: 0 0 1rem; }
    h3 { font-size: 1.6rem; margin: 0 0 0.75rem; }
    p { color: vars.$muted; line-height: 1.7; }

    .steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
        gap: 2rem;
        margin: 4rem 0;
    }

    .step {
        padding: 2rem;
        border-radius: 2px;
        border: 1px solid vars.$line;

        // Numéro d'étape dans un cercle fin rouge : un petit accent du logo
        .number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.75rem;
            height: 2.75rem;
            border: 1px solid vars.$red;
            border-radius: 50%;
            font-family: vars.$font-titles;
            font-size: 1.4rem;
            font-weight: 600;
            font-variant-numeric: lining-nums;
            margin-bottom: 1.25rem;
        }
    }

    .action-box {
        background-color: vars.$charcoal-soft;
        padding: 3rem;
        border-radius: 2px;
        border: 1px solid vars.$line;

        .btn-primary { margin-top: 1rem; }
    }

    .badge {
        @include vars.label;
        display: inline-block;
        padding: 0.4rem 1rem;
        border: 1px solid vars.$line;
        border-radius: 2px;
        font-size: 0.72rem;
        color: vars.$muted;
        margin-bottom: 1.25rem;
    }

    .form-container {
        margin-top: 5rem; // On espace bien de la partie mail
    }

    .gform-wrapper {
        margin-top: 2rem;
        padding: 3rem 1rem;
        border: 1px dashed vars.$line;
        border-radius: 2px;

        .gform-note {
            margin-top: 1rem;
            font-size: 0.85rem;
        }
    }

    @media (max-width: 768px) {
        .devis-page { padding-top: 120px; }
        h1 { font-size: 2.4rem; }
        h2 { font-size: 1.9rem; }
        .action-box { padding: 2.25rem 1.5rem; }
    }
</style>
