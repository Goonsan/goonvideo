---
// src/pages/tarifs.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingGrid from '../components/PricingGrid.astro';
---

<Layout
    title="Tarifs Vidéaste Mariage & Clip à Nantes 2026 | Towa Film"
    description="Tarifs 2026 de Towa Film, vidéaste à Nantes : film de mariage dès 1000 €, clip musical dès 500 €, vidéo d'entreprise dès 450 €, réseaux sociaux dès 250 €."
    breadcrumbs={[{ name: 'Tarifs', url: '/tarifs/' }]}
>
    <Header />
    <main id="main-content" style="padding-top: 100px;"> <h1 style="text-align: center; font-size: 3rem;">Tarifs Vidéaste Nantes 2026</h1>
        <p class="intro">
            Des formules claires pour vos <a href="/videaste-mariage-nantes/">films de mariage</a>,
            vos <a href="/clip-musical-nantes/">clips musicaux</a> et vos <a href="/video-entreprise-nantes/">vidéos d'entreprise</a>, à Nantes, en Loire-Atlantique et dans le Grand Ouest.
            Chaque projet est unique : n'hésitez pas à demander un devis personnalisé.
        </p>
        <PricingGrid showServiceLink />
    </main>

    <section class="cta-section">
        <h2>Un projet spécifique ?</h2>
        <p>Contactez-moi pour un devis personnalisé adapté à vos besoins.</p>
        <a href="mailto:contact@towafilm.fr" class="btn-outlined">Me contacter</a>
    </section>

    <style lang="scss">
        @use "../styles/variables" as vars;

        .intro {
            max-width: 800px;
            margin: 0 auto 2rem;
            padding: 0 1rem;
            text-align: center;
            line-height: 1.8;
            color: vars.$muted;

            a { @include vars.content-link; color: white; }
        }
        .cta-section {
            text-align: center;
            padding: 5rem 1rem;
            background-color: vars.$charcoal-soft;
            border-top: 1px solid vars.$line;

            h2 { font-size: 2.4rem; margin: 0 0 1rem; }
            p { color: vars.$muted; margin: 0 0 2rem; }
        }
    </style>

    <Footer />
</Layout>