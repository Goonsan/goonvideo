</Layout>

<style lang="scss">
    @use "../styles/variables" as vars;

    .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
    section { padding: 110px 0; }

    .section-title { text-align: center; margin: 0 0 3.5rem; font-size: 2.8rem; }

    .text-center { text-align: center; }
    .max-width-text { max-width: 760px; margin: 2rem auto 2.5rem; line-height: 1.9; font-size: 1.05rem; color: vars.$muted; }

    // Petit label en capitales espacées, précédé d'un filet rouge (décor, pas du texte rouge)
    .subtitle {
        @include vars.label;
        color: vars.$muted;
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;

        &::before {
            content: "";
            width: 2rem;
            height: 1px;
            background-color: vars.$red;
        }
    }

    strong { font-weight: 600; color: white; }

    .about-seo {
        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5rem;
            align-items: center;
        }
        h1 { font-size: clamp(2.4rem, 4.2vw, 3.4rem); margin: 1.25rem 0 1rem; }
        .tagline {
            font-family: vars.$font-titles;
            font-style: italic;
            font-size: 1.6rem;
            margin: 0;
            color: vars.$muted;
        }
        p { line-height: 1.9; color: vars.$muted; margin: 0 0 1.5rem; }
    }

    .services-detail { background-color: vars.$charcoal-soft; }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
        gap: 2rem;
    }

    .service-card {
        display: flex;
        flex-direction: column;
        padding: 2.75rem 2.5rem;
        border: 1px solid vars.$line;
        border-radius: 2px;
        transition: border-color 0.3s ease;

        // Un filet rouge fin au-dessus du titre, à la place des icônes
        &::before {
            content: "";
            width: 2.5rem;
            height: 2px;
            background-color: vars.$red;
            margin-bottom: 1.75rem;
        }
        &:hover { border-color: rgba(255, 255, 255, 0.3); }

        h3 { font-size: 1.75rem; margin: 0 0 1rem; }
        > p { color: vars.$muted; line-height: 1.8; margin: 0; }
        ul {
            margin: 1.75rem 0 0; list-style: none; padding: 0;
            li {
                position: relative;
                padding-left: 1.5rem;
                font-size: 0.9rem;
                line-height: 1.6;
                color: vars.$muted;
                margin-bottom: 0.6rem;
                // Puce : un tiret fin rouge
                &::before {
                    content: "";
                    position: absolute;
                    left: 0;
                    top: 0.8em;
                    width: 0.75rem;
                    height: 1px;
                    background-color: vars.$red;
                }
            }
        }
        .card-link {
            @include vars.content-link;
            margin-top: auto;
            padding-top: 1.75rem;
            align-self: flex-start;
            font-weight: 500;
            font-size: 0.9rem;
            text-underline-offset: 6px;
            &:hover { color: vars.$muted; }
        }
    }

    .video-value h2 { font-size: 2.8rem; margin: 1.25rem 0 0; }

    .points-forts { background-color: vars.$charcoal-soft; }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 3.5rem 5rem;
        max-width: 960px;
        margin: 0 auto;
    }

    .feature-item {
        padding-top: 1.5rem;
        border-top: 1px solid vars.$line;
        h3 { font-size: 1.6rem; margin: 0 0 0.75rem; }
        p { color: vars.$muted; line-height: 1.8; margin: 0; }
    }

    // Les widgets d'avis (Elfsight, Mariages.net) sont générés par des scripts externes :
    // on coupe ce qui dépasse de la section pour éviter un scroll horizontal sur mobile
    .testimonials {
        overflow: hidden;
    }

    // Sections claires blanc cassé : texte charbon
    .testimonials--light {
        background-color: vars.$offwhite;
        color: vars.$charcoal;

        .section-title { color: vars.$charcoal; }
        a { color: vars.$charcoal; }
    }
    // Les deux sections d'avis se suivent : on ne double pas l'espacement entre elles
    .testimonials--light + .testimonials--light { padding-top: 0; }

    .former-name {
        @include vars.label;
        text-align: center;
        color: rgba(17, 17, 17, 0.65);
        margin: -2.5rem 0 3rem;
    }

    .testimonials-grid {
        display: grid;
        place-items: center;
        background-color: #fff;
        border-radius: 2px;

        // Utilisation de :global pour cibler les classes injectées par le script externe
        :global(.weddingWireWidgetReview__post) {
            display: block !important;
            color: #333 !important;
            visibility: visible !important;
            font-size: 0.9rem !important;
            line-height: 1.5 !important;
            margin-top: 10px !important;
        }

        :global(.weddingWireWidgetReview__title) {
            color: vars.$charcoal !important;
            font-weight: bold !important;
        }
    }

    /* --- RESPONSIVE MOBILE --- */
    @media (max-width: 900px) {
        .about-seo .about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    }

    @media (max-width: 768px) {
        section { padding: 70px 0; }

        .section-title { font-size: 2.2rem; margin-bottom: 2.5rem; }
        .former-name { margin-top: -1.5rem; letter-spacing: 0.12em; }
        .video-value h2 { font-size: 2.2rem; }
        .about-seo .tagline { font-size: 1.35rem; }

        .container { padding: 0 1.5rem; }

        .service-card { padding: 2.25rem 1.75rem; }

        .features-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    }

    //widget avis
    .reviews-wrapper {
        min-height: 200px;
        margin-bottom: 2rem;
    }
    .es-widget-title-container {
        display: none;
    }
    .mariagesnet-widget {
        min-height: 100px;
        border-radius: 2px;
        overflow: hidden;
    }
    .google-reviews-link {
        text-align: center;
        margin-top: 0.5rem;

        a {
            @include vars.content-link;
            font-weight: 500;
            font-size: 0.9rem;
        }
    }
</style>
