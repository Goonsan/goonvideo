---
// src/components/Hero.astro
// Vidéo en plein écran : le logo, le slogan et un bouton, rien d'autre par-dessus.
---

<section class="hero" aria-label="Towa Film">
    <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster="/images/hero-poster.webp"
        aria-hidden="true"
    >
        <!-- Showreel 2026 : H.264 1920×812 sans bandes noires ni son, lu par tous les navigateurs.
             Les vidéos ne sont pas dans git : elles se copient à la main sur le serveur, dans dist/videos/ -->
        <source src="/videos/showreel-2026.mp4" type="video/mp4">
    </video>

    <div class="hero__content">
        <img
            class="hero__logo"
            src="/images/logo-towa-film-hero.webp"
            width="1004"
            height="320"
            alt="Towa Film"
            fetchpriority="high"
        />
        <p class="hero__slogan">L’instant passe. L’image reste.</p>
        <a href="/portfolio/" class="btn-outlined">Découvrir mes films</a>
    </div>
</section>

<script>
    // Animations réduites demandées par le visiteur : on reste sur l'image fixe
    const video = document.querySelector<HTMLVideoElement>('.hero__video');
    if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        video.removeAttribute('autoplay');
        video.pause();
    }
</script>

<style lang="scss">
    @use "../styles/variables" as vars;

    .hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;  // navigateurs anciens
        min-height: 100svh; // mobile : hauteur visible sans la barre d'adresse
        padding: 6rem 1rem 3rem; // le haut reste libre sous l'en-tête fixe
        box-sizing: border-box;
        overflow: hidden;
        background-color: vars.$charcoal; // le temps que l'image d'attente arrive
        text-align: center;

        // Voile léger : le logo blanc reste lisible même sur les plans clairs,
        // et le bas se fond dans la section suivante
        &::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(
                to bottom,
                rgba(17, 17, 17, 0.55) 0%,
                rgba(17, 17, 17, 0.3) 35%,
                rgba(17, 17, 17, 0.35) 75%,
                vars.$charcoal 100%
            );
            pointer-events: none;
        }
    }

    .hero__video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }

    .hero__content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero__logo {
        width: min(500px, 70vw);
        height: auto;
        filter: drop-shadow(0 2px 18px rgba(0, 0, 0, 0.35));
    }

    .hero__slogan {
        font-family: vars.$font-titles;
        font-style: italic;
        font-weight: 500;
        font-size: clamp(1.35rem, 2.4vw, 2rem);
        line-height: 1.3;
        margin: 1.75rem 0 2.75rem;
        color: white;
        text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
    }
</style>
