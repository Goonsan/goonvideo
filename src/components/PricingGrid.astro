---
// src/components/PricingGrid.astro
import { pricing, type PricingCategory } from '../data/pricing';

interface Props {
    categories?: PricingCategory[];
    level?: 2 | 3;            // niveau de titre des catégories (h2 sur la page Tarifs, h3 dans une section)
    showServiceLink?: boolean; // lien vers la page de prestation détaillée
}

const { categories = pricing, level = 2, showServiceLink = false } = Astro.props;
const CategoryTag = `h${level}` as 'h2' | 'h3';
const PackTag = `h${level + 1}` as 'h3' | 'h4';
---

<section class="pricing-container">
    {categories.map((category) => (
        <div class="category">
            <CategoryTag class="category-title">{category.title}</CategoryTag>
            <div class="grid">
                {category.packs.map((pack) => (
                    <div class={pack.featured ? 'card featured' : 'card'}>
                        {pack.featured && <div class="badge">Populaire</div>}
                        <PackTag class="pack-name">{pack.name}</PackTag>
                        <p class="price">{pack.price} €</p>
                        <p class="desc">{pack.desc}</p>
                        {pack.included && <span class="option_inclus">{pack.included}</span>}
                    </div>
                ))}
            </div>
            {category.extras && (
                <p class="extra">
                    {category.extras.map((extra) => <span>{extra}</span>)}
                </p>
            )}
            {category.note && (
                <p class="travel-note">
                    {category.note}
                </p>
            )}
            {showServiceLink && (
                <p class="service-link">
                    <a href={category.serviceUrl}>En savoir plus sur la prestation {category.title.toLowerCase()} →</a>
                </p>
            )}
        </div>
    ))}
</section>

<style lang="scss">
    @use "../styles/variables" as vars;

    .pricing-container {
        padding: 2rem 1rem;
        max-width: 1100px;
        margin: 0 auto;
    }
    .category {
        margin-bottom: 5rem;
    }
    // Un filet rouge fin devant le titre, à la place des émojis
    .category-title {
        font-size: 2.4rem;
        color: white;
        margin: 0 0 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;

        &::before {
            content: "";
            flex: 0 0 2.5rem;
            height: 2px;
            background-color: vars.$red;
        }
    }

    /* Sur téléphone, « Communication Récurrente » doit tenir dans l'écran (sinon scroll horizontal) */
    @media (max-width: 600px) {
        .category-title { font-size: 1.9rem; gap: 0.75rem; }
        .category-title::before { flex-basis: 1.5rem; }
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
        gap: 1.5rem;
    }
    .card {
        border: 1px solid vars.$line;
        padding: 2.25rem 2rem 2rem;
        border-radius: 2px;
        text-align: center;
        transition: border-color 0.3s ease;
        display: flex;
        flex-direction: column;
    }
    .card:hover {
        border-color: rgba(255, 255, 255, 0.3);
    }
    // Formule mise en avant : le rouge du logo, en petit accent
    .featured {
        position: relative;
        border-color: vars.$red;
        &:hover { border-color: vars.$red; }
    }
    .badge {
        position: absolute;
        top: -0.7rem;
        left: 50%;
        transform: translateX(-50%);
        background: vars.$red;
        color: white;
        padding: 0.2rem 0.8rem;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        border-radius: 2px;
    }
    .pack-name {
        margin: 0;
        font-family: vars.$font-titles;
        font-size: 1.6rem;
        font-weight: 600;
        color: white;
    }
    .price {
        font-family: vars.$font-titles;
        font-size: 3rem;
        font-weight: 600;
        font-variant-numeric: lining-nums; // « 1000 » et non « IOOO »
        margin: 0.75rem 0 1rem;
        color: white;
    }
    .desc {
        font-size: 0.92rem;
        line-height: 1.6;
        color: vars.$muted;
        min-height: 3em;
    }
    .extra {
        margin-top: 3rem;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;

        span {
            border: 1px solid vars.$line;
            color: vars.$muted;
            padding: 0.5rem 1.1rem;
            border-radius: 2px;
            font-size: 0.85rem;
            font-weight: 500;
        }
    }
    .travel-note {
        margin-top: 1.5rem;
        text-align: center;
        font-size: 0.85rem;
        color: vars.$muted;
    }
    .service-link {
        margin-top: 1.5rem;
        text-align: center;

        a {
            @include vars.content-link;
            font-weight: 500;
            font-size: 0.9rem;
        }
    }
    .option_inclus {
        @include vars.label;
        margin-top: auto; /* Aligné en bas */
        font-size: 0.72rem;
        color: white;
    }
</style>
