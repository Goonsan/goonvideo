---
// src/components/PricingGrid.astro
import { pricing, type PricingCategory } from '../data/pricing';

interface Props {
    categories?: PricingCategory[];
    level?: 2 | 3;            // niveau de titre des catégories (h2 sur la page Tarifs, h3 dans une section)
    showServiceLink?: boolean; // lien vers la page de prestation détaillée
}

const { categories = pricing, level = 2, showServiceLink = false } = Astro.props;
const CategoryTag = `h${level}` as 'h2' | 'h3';
const PackTag = `h${level + 1}` as 'h3' | 'h4';
---

<section class="pricing-container">
    {categories.map((category) => (
        <div class="category">
            <CategoryTag class="category-title"><span aria-hidden="true">{category.icon}</span> {category.title}</CategoryTag>
            <div class="grid">
                {category.packs.map((pack) => (
                    <div class={pack.featured ? 'card featured' : 'card'}>
                        {pack.featured && <div class="badge">Populaire</div>}
                        <PackTag class="pack-name">{pack.name}</PackTag>
                        <p class="price">{pack.price} €</p>
                        <p class="desc">{pack.desc}</p>
                        {pack.included && <span class="option_inclus">{pack.included}</span>}
                    </div>
                ))}
            </div>
            {category.extras && (
                <p class="extra">
                    {category.extras.map((extra) => <span>{extra}</span>)}
                </p>
            )}
            {category.note && (
                <p class="travel-note">
                    <span aria-hidden="true">📍</span> {category.note}
                </p>
            )}
            {showServiceLink && (
                <p class="service-link">
                    <a href={category.serviceUrl}>En savoir plus sur la prestation {category.title.toLowerCase()} →</a>
                </p>
            )}
        </div>
    ))}
</section>

<style lang="scss">
    /* Le reste de ton SCSS reste identique, il s'appliquera automatiquement à la nouvelle section */
    .pricing-container {
        padding: 2rem 1rem;
        max-width: 1100px;
        margin: 0 auto;
    }
    .category {
        margin-bottom: 5rem;
    }
    .category-title {
        font-size: 2.2rem;
        color: var(--gold, #e5c35c);
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 15px;
        text-transform: uppercase;
    }
    .category-title span { font-size: 1.8rem; }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }
    .card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 2rem;
        border-radius: 12px;
        text-align: center;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }
    .card:hover {
        background: rgba(255, 255, 255, 0.07);
        transform: translateY(-5px);
        border-color: var(--gold, #e5c35c);
    }
    .featured {
        border: 2px solid var(--gold, #e5c35c);
        position: relative;
        background: rgba(229, 195, 92, 0.05);
    }
    .badge {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--gold, #e5c35c);
        color: #030f25;
        padding: 2px 12px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        border-radius: 20px;
    }
    .pack-name { margin: 0; font-size: 1.3rem; opacity: 0.9; font-family: 'Playfair Display', serif; color: var(--gold, #e5c35c); }
    .price {
        font-size: 2.8rem;
        font-weight: 800;
        margin: 1rem 0;
        color: #fff;
    }
    .desc {
        font-size: 0.95rem;
        line-height: 1.5;
        color: #aaa;
        min-height: 3em;
    }
.extra {
        margin-top: 3rem;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem; /* Espace entre les badges */
        
        span {
            background: rgba(229, 195, 92, 0.05); /* Léger fond doré transparent */
            border: 1px solid rgba(229, 195, 92, 0.3); /* Bordure dorée très subtile */
            color: var(--gold, #e5c35c);
            padding: 0.5rem 1.2rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s ease;

            &:hover {
                background: rgba(229, 195, 92, 0.15);
                border-color: var(--gold, #e5c35c);
            }
        }
    }
.travel-note {
        margin-top: 1.5rem;
        text-align: center;
        font-size: 0.85rem;
        opacity: 0.6;
    }
.service-link {
        margin-top: 1.5rem;
        text-align: center;

        a {
            color: var(--gold, #e5c35c);
            font-weight: 600;
            font-size: 0.95rem;
        }
    }
.option_inclus {
        margin-top: auto; /* Aligné en bas */
        color: var(--gold, #e5c35c);
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        opacity: 0.9;
    }
</style>