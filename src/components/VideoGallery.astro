---
import { videos as allVideos, thumbnailUrl, type Video } from '../data/videos';

interface Props {
    categories?: Video['category'][]; // si renseigné : n'affiche que ces catégories, sans barre de filtres
    level?: 2 | 3;                    // niveau de titre des vidéos
}

const { categories: only, level = 2 } = Astro.props;
const videos = only ? allVideos.filter(v => only.includes(v.category)) : allVideos;
const categories = ['Tous', ...new Set(videos.map(v => v.category))];
const TitleTag = `h${level}` as 'h2' | 'h3';

// Données structurées : chaque vidéo déclarée à Google (VideoObject)
const videoSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: videos.map((video, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
            '@type': 'VideoObject',
            name: video.title,
            description: video.description,
            thumbnailUrl: thumbnailUrl(video.id),
            uploadDate: video.uploadDate,
            duration: video.duration,
            embedUrl: `https://www.youtube-nocookie.com/embed/${video.id}`,
            contentUrl: `https://www.youtube.com/watch?v=${video.id}`,
            creator: { '@id': 'https://goonvideo.fr/#olivier-gonnet' },
        },
    })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(videoSchema)} />

<div class="portfolio-section">
    {!only && (
        <div class="filter-container" role="group" aria-label="Filtrer le portfolio par catégorie">
            {categories.map(cat => (
                <button
                    type="button"
                    class={cat === 'Tous' ? 'filter-btn active' : 'filter-btn'}
                    data-category={cat === 'Tous' ? 'all' : cat}
                    aria-pressed={cat === 'Tous' ? 'true' : 'false'}
                >
                    {cat}
                </button>
            ))}
        </div>
    )}

    <div class="video-grid">
        {videos.map((video) => (
            <div class="video-card" data-category={video.category}>
                <div
                    class="thumbnail-wrapper"
                    data-video-id={video.id}
                    data-video-title={video.title}
                    role="button"
                    tabindex="0"
                    aria-label={`Lire la vidéo : ${video.title}`}
                >
                    <img
                        src={thumbnailUrl(video.id)}
                        alt=""
                        loading="lazy"
                        width="480"
                        height="360"
                    />
                    <div class="play-overlay">
                        <span class="play-text">Lire la vidéo</span>
                    </div>
                    <div class="category-badge">{video.category}</div>
                </div>
                <TitleTag class="video-title">{video.title}</TitleTag>
            </div>
        ))}
    </div>
</div>

<script>
    // Filtrage
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.video-card');

    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            const filter = btn.getAttribute('data-category');
            buttons.forEach(b => {
                b.classList.remove('active');
                b.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('active');
            btn.setAttribute('aria-pressed', 'true');
            cards.forEach(card => {
                if (filter === 'all' || card.getAttribute('data-category') === filter) {
                    (card as HTMLElement).style.display = 'block';
                } else {
                    (card as HTMLElement).style.display = 'none';
                }
            });
        });
    });

    // Injection de l'iframe avec correction de taille
    const wrappers = document.querySelectorAll('.thumbnail-wrapper');
    wrappers.forEach(wrapper => {
        const playVideo = () => {
            const id = wrapper.getAttribute('data-video-id');
            const title = wrapper.getAttribute('data-video-title') || 'Vidéo';
            // Ajout de classes CSS pour forcer la taille
            wrapper.innerHTML = `
                <iframe
                    class="active-video"
                    title="${title}"
                    src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1"
                    frameborder="0"
                    allow="autoplay; encrypted-media"
                    allowfullscreen>
                </iframe>
            `;
        };

        wrapper.addEventListener('click', playVideo);
        wrapper.addEventListener('keydown', (e) => {
            const event = e as KeyboardEvent;
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                playVideo();
            }
        });
    });
</script>

<style lang="scss">
    @use "../styles/variables" as *;

    .portfolio-section { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem 5rem; }

    .filter-container {
        display: flex; justify-content: center; gap: 1rem; margin-bottom: 4rem; flex-wrap: wrap;
    }

    .filter-btn {
        background: transparent; border: 1px solid rgba(255,255,255,0.1);
        color: white; padding: 0.6rem 1.5rem; border-radius: 30px; cursor: pointer;
        transition: all 0.3s ease; text-transform: uppercase;
        &:hover, &.active { background: $gold; color: $dark-blue; border-color: $gold; }
    }

    .video-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 3rem 2rem;
    }

    .thumbnail-wrapper {
        position: relative;
        padding-bottom: 56.25%; // Ratio 16:9
        height: 0;
        background: #000;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;

        &:focus-visible {
            outline: 2px solid $gold;
            outline-offset: 4px;
        }

        img {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            object-fit: cover;
        }

        // CRUCIAL : L'iframe doit remplir le conteneur 16:9
        iframe.active-video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        .play-overlay {
            position: absolute; inset: 0; background: rgba(0,0,0,0.4);
            display: flex; align-items: center; justify-content: center;
            opacity: 1; transition: opacity 0.3s ease;
            .play-text { border: 1px solid white; padding: 0.8rem 1.5rem; color: white; }
        }
        &:hover img { transform: scale(1.05); transition: 0.5s; }
    }

    .video-title { margin-top: 1rem; font-size: 1.1rem; color: white; }
    .category-badge {
        position: absolute; top: 1rem; left: 1rem; background: rgba(0,0,0,0.7);
        color: $gold; padding: 4px 12px; font-size: 0.7rem; font-weight: bold;
    }

    @media (max-width: 768px) {
        .video-grid { grid-template-columns: 1fr; }
    }

    .thumbnail-wrapper {
        position: relative;
        padding-bottom: 56.25%; /* Ratio 16:9 */
        height: 0;
        background: #000;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;

        img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* --- LE FIX CRUCIAL ICI --- */
        /* :global() permet de cibler l'iframe injectée par le JS */
        :global(iframe) {
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 100% !important;
            border: none !important;
        }
    }
</style>