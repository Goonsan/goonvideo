---
// src/layouts/Layout.astro
const {
	title,
	description = "Olivier Gonnet, vidéaste à Nantes : captation et montage pour mariages, clips musicaux et vidéos d'entreprise en Loire-Atlantique et dans le Grand Ouest.",
	image = "/apple-touch-icon.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://goonvideo.fr");
const ogImageURL = new URL(image, "https://goonvideo.fr");
---

<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="Goon Video" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;700&display=swap" rel="stylesheet">
		<!-- JSON-LD : Données structurées pour Google -->
		<script type="application/ld+json" is:inline>
		{
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"name": "Goon Video",
			"alternateName": "Goonvideo",
			"url": "https://goonvideo.fr",
			"logo": "https://goonvideo.fr/apple-touch-icon.png",
			"image": "https://goonvideo.fr/apple-touch-icon.png",
			"address": {
			"@type": "PostalAddress",
			"streetAddress": "10 rue du Berligout",
			"postalCode": "44880",
			"addressLocality": "Sautron",
			"addressRegion": "Loire-Atlantique",
			"addressCountry": "FR"
			},
			"areaServed": ["Nantes", "Loire-Atlantique", "Grand Ouest"],
			"priceRange": "250€ - 2000€",
			"sameAs": [
			"https://www.mariages.net/video-mariage/goon--e399735/avis",
			"https://www.instagram.com/oliviergonnet.video",
			"https://www.youtube.com/@OlivierGonnet",
			"https://share.google/Ovvgyh7M0fu1YtiZu"
			]
		}
		</script>

		<!-- Cloudflare Web Analytics (sans cookie, pas de consentement requis) -->
		<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "1ff04095aec8484381012abc4a3ed602"}' is:inline></script>
		<!-- End Cloudflare Web Analytics -->

		<!-- Bandeau de consentement RGPD (tarteaucitron, auto-hébergé) -->
		<script src="/tarteaucitron/tarteaucitron.min.js" is:inline></script>
		<script is:inline>
		tarteaucitron.init({
			privacyUrl: "/politique-de-confidentialite/",
			bodyPosition: "bottom",
			hashtag: "#tarteaucitron",
			cookieName: "tarteaucitron",
			orientation: "bottom",
			groupServices: false,
			showAlertSmall: false,
			cookieslist: false,
			showIcon: true,
			iconPosition: "BottomRight",
			adblocker: false,
			DenyAllCta: true,
			AcceptAllCta: true,
			highPrivacy: true,
			handleBrowserDNTRequest: false,
			removeCredit: false,
			moreInfoLink: true,
			useExternalCss: false,
			useExternalJs: false,
			readmoreLink: "/politique-de-confidentialite/",
			mandatory: true,
			mandatoryCta: true
		});

		// Google Analytics (GA4) — ne se charge qu'après consentement
		tarteaucitron.services.gtag = {
			key: "gtag",
			type: "analytic",
			name: "Google Analytics",
			uri: "https://policies.google.com/privacy",
			needConsent: true,
			cookies: ["_ga", "_ga_*", "_gid", "_gat"],
			js: function () {
				"use strict";
				window.dataLayer = window.dataLayer || [];
				window.gtag = function () { dataLayer.push(arguments); };
				gtag("js", new Date());
				gtag("config", "G-X3TFLQW7SH", { anonymize_ip: true });

				var s = document.createElement("script");
				s.async = true;
				s.src = "https://www.googletagmanager.com/gtag/js?id=G-X3TFLQW7SH";
				document.head.appendChild(s);
			}
		};
		(tarteaucitron.job = tarteaucitron.job || []).push("gtag");
		</script>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Aller au contenu principal</a>
		<slot /> </body>
</html>

<style is:global lang="scss">
	$gold: #e5c35c;
  	$dark-blue: #030f25;
  	$font-titles: 'Playfair Display', serif;
  	$font-body: 'Plus Jakarta Sans', sans-serif;

  	:root {
    	--gold: #{$gold}; // On fait passer la variable Sass en variable CSS pour le reste du site
    	--dark-blue: #{$dark-blue};
  	}

	html, body {
		margin: 0;
		padding: 0;
		background-color: $dark-blue;
		color: white;
		font-family: $font-body;
		-webkit-font-smoothing: antialiased; // Rend les polices plus fines/propres sur Mac/Chrome
	}

	h1, h2, h3 {
		font-family: $font-titles;
		color: $gold;
	}

	a {
		color: white;
		text-decoration: none;
		transition: color 0.3s ease;

		&:hover {
		color: $gold;
		}
	}

	.btn-yellow {
		position: relative;
		background-color: $gold;
		color: #111;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		font-weight: 700;
		text-transform: uppercase;
		font-size: 0.9rem;
		box-shadow: 0 1px 14px #000;
		text-shadow: 0 0 0px rgba(0, 0, 0, 0.5);
		transition: all 0.3s ease;
		overflow: hidden;
		z-index: 1;

		&:before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			width: 0%;
			height: 100%;
			background: #fff;
			z-index: -1;
			transition: all 0.3s ease;
		}

		&:hover {
			background-color: #fff;
			color: #000;
			box-shadow: 0 0 0 #00000000;
			text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
			&:before {
				width: 100%;
			}
		}
	}

	.btn-outlined {
		background-color: transparent;
		border: 2px solid white;
		color: white;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		font-weight: 700;
		text-transform: uppercase;
		font-size: 0.9rem;
	}

	/* Reset simple */
	* { box-sizing: inherit; }

	/* accessibilité */
	a:focus-visible, button:focus-visible, .btn-gold:focus-visible {
		outline: 2px solid $gold;
		outline-offset: 4px;
	}

	.skip-link {
		position: absolute;
		top: -4rem;
		left: 0.5rem;
		z-index: 1000;
		background: $gold;
		color: #111;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		font-weight: 700;
		text-decoration: none;
		transition: top 0.2s ease;

		&:focus-visible {
			top: 0.5rem;
		}
	}
</style>