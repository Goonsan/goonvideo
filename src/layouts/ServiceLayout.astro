---
// src/layouts/ServiceLayout.astro
// Gabarit commun des pages de prestation (mariage, clip, entreprise).
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoGallery from '../components/VideoGallery.astro';
import PricingGrid from '../components/PricingGrid.astro';
import { getPricing, type PricingCategory } from '../data/pricing';
import type { Video } from '../data/videos';

interface Props {
    title: string;
    description: string;
    breadcrumbName: string;
    eyebrow: string;
    heading: string;
    lead: string;
    serviceName: string;
    serviceType: string;
    videosTitle: string;
    videoCategories: Video['category'][];
    pricingIds: PricingCategory['id'][];
    faq: { q: string; a: string }[];
}

const {
    title, description, breadcrumbName, eyebrow, heading, lead,
    serviceName, serviceType, videosTitle, videoCategories, pricingIds, faq,
} = Astro.props;

const SITE = 'https://goonvideo.fr';
const pageURL = new URL(Astro.url.pathname, SITE).href;
const categories = getPricing(pricingIds);

const services = [
    { name: 'Vidéaste mariage', url: '/videaste-mariage-nantes/' },
    { name: 'Clip musical & captation live', url: '/clip-musical-nantes/' },
    { name: "Vidéo d'entreprise", url: '/video-entreprise-nantes/' },
];
const otherServices = services.filter((s) => new URL(s.url, SITE).href !== pageURL);

const schema = [
    {
        '@type': 'Service',
        '@id': `${pageURL}#service`,
        name: serviceName,
        serviceType,
        description,
        url: pageURL,
        provider: { '@id': `${SITE}/#business` },
        areaServed: [
            { '@type': 'City', name: 'Nantes' },
            { '@type': 'AdministrativeArea', name: 'Loire-Atlantique' },
            { '@type': 'AdministrativeArea', name: 'Pays de la Loire' },
        ],
        offers: categories.flatMap((category) =>
            category.packs.map((pack) => ({
                '@type': 'Offer',
                name: `${category.title} – ${pack.name}`,
                description: pack.desc,
                price: pack.price,
                priceCurrency: 'EUR',
                url: pageURL,
            })),
        ),
    },
    {
        '@type': 'FAQPage',
        '@id': `${pageURL}#faq`,
        mainEntity: faq.map((item) => ({
            '@type': 'Question',
            name: item.q,
            acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
    },
];
---

<Layout
    title={title}
    description={description}
    breadcrumbs={[{ name: breadcrumbName, url: Astro.url.pathname }]}
    schema={schema}
>
    <Header />
    <main id="main-content" class="service-page">
        <header class="page-header">
            <nav aria-label="Fil d'Ariane" class="breadcrumb">
                <a href="/">Accueil</a>
                <span aria-hidden="true">›</span>
                <span aria-current="page">{breadcrumbName}</span>
            </nav>
            <span class="subtitle">{eyebrow}</span>
            <h1 class="page-title">{heading}</h1>
            <div class="title-underline"></div>
            <p class="lead">{lead}</p>
            <div class="header-actions">
                <a href="/devis/" class="btn-yellow">Demander un devis</a>
                <a href="#realisations" class="btn-outlined">Voir mes réalisations</a>
            </div>
        </header>

        <div class="service-content">
            <slot />
        </div>

        <section id="realisations" class="block">
            <h2 class="section-title">{videosTitle}</h2>
            <VideoGallery categories={videoCategories} level={3} />
            <p class="more-link"><a href="/portfolio/">Voir tout le portfolio →</a></p>
        </section>

        <section class="block pricing">
            <h2 class="section-title">Tarifs</h2>
            <PricingGrid categories={categories} level={3} />
            <p class="more-link"><a href="/tarifs/">Voir tous mes tarifs →</a></p>
        </section>

        <section class="block faq">
            <h2 class="section-title">Questions fréquentes</h2>
            <div class="faq-list">
                {faq.map((item) => (
                    <details>
                        <summary>{item.q}</summary>
                        <p set:html={item.a} />
                    </details>
                ))}
            </div>
        </section>

        <section class="cta-section">
            <h2>Parlons de votre projet</h2>
            <p>Décrivez-moi votre projet et vos dates : je vous réponds rapidement avec une proposition sur mesure.</p>
            <div class="header-actions">
                <a href="/devis/" class="btn-yellow">Demander un devis</a>
                <a href="/contact/" class="btn-outlined">Me contacter</a>
            </div>
        </section>

        <nav class="other-services" aria-label="Autres prestations">
            <span>Découvrez aussi :</span>
            {otherServices.map((service) => <a href={service.url}>{service.name}</a>)}
        </nav>
    </main>
    <Footer />
</Layout>

<style lang="scss">
    @use "../styles/variables" as vars;

    .service-page { padding-top: 150px; background: vars.$dark-blue; }

    .page-header {
        text-align: center;
        max-width: 900px;
        margin: 0 auto 4rem;
        padding: 0 1.5rem;

        .breadcrumb {
            display: flex;
            justify-content: center;
            gap: 0.6rem;
            font-size: 0.85rem;
            opacity: 0.6;
            margin-bottom: 2rem;
        }

        .subtitle {
            color: vars.$gold;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 0.9rem;
            display: block;
            margin-bottom: 1rem;
        }
        .page-title { font-size: 3.5rem; color: white; margin: 0; }
        .title-underline { width: 60px; height: 3px; background: vars.$gold; margin: 1.5rem auto 2rem; }
        .lead { font-size: 1.15rem; line-height: 1.8; opacity: 0.9; }
    }

    .header-actions {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    // Contenu fourni par chaque page (slot) : styles globaux limités à ce bloc
    .service-content {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 1.5rem;

        :global(h2) { font-size: 2.2rem; margin: 4rem 0 1.5rem; }
        :global(p) { line-height: 1.8; opacity: 0.85; font-size: 1.05rem; }
        :global(a) { color: vars.$gold; text-decoration: underline; }
        :global(ul), :global(ol) { padding-left: 0; list-style: none; }
        :global(li) {
            position: relative;
            padding-left: 2rem;
            margin-bottom: 1rem;
            line-height: 1.7;
            opacity: 0.9;
        }
        :global(ul li::before) { content: "→"; color: vars.$gold; position: absolute; left: 0; }
        :global(ol) { counter-reset: step; }
        :global(ol li) { counter-increment: step; }
        :global(ol li::before) {
            content: counter(step);
            position: absolute;
            left: 0;
            top: 0.2rem;
            width: 1.4rem;
            height: 1.4rem;
            border-radius: 50%;
            background: vars.$gold;
            color: vars.$dark-blue;
            font-size: 0.8rem;
            font-weight: 700;
            text-align: center;
            line-height: 1.4rem;
        }
    }

    .block { padding: 80px 0 0; }
    .section-title { text-align: center; margin-bottom: 3rem; font-size: 2.5rem; }

    .more-link {
        text-align: center;
        margin-top: 0;
        a { color: vars.$gold; font-weight: 600; }
    }

    .faq-list {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 1.5rem;

        details {
            border-bottom: 1px solid rgba(vars.$gold, 0.3);
            padding: 1.2rem 0;
        }
        summary {
            cursor: pointer;
            font-weight: 700;
            font-size: 1.1rem;
            list-style: none;
            display: flex;
            justify-content: space-between;
            gap: 1rem;

            &::-webkit-details-marker { display: none; }
            &::after { content: "+"; color: vars.$gold; font-size: 1.4rem; line-height: 1; }
        }
        details[open] summary::after { content: "−"; }
        p {
            line-height: 1.8;
            opacity: 0.85;
            margin: 1rem 0 0;
            :global(a) { color: vars.$gold; text-decoration: underline; }
        }
    }

    .cta-section {
        text-align: center;
        padding: 5rem 1.5rem;
        margin-top: 80px;
        background: linear-gradient(to bottom, transparent, rgba(vars.$gold, 0.1));
        h2 { font-size: 2.2rem; margin: 0 0 1rem; }
        p { opacity: 0.85; max-width: 600px; margin: 0 auto; line-height: 1.7; }
    }

    .other-services {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.8rem 2rem;
        padding: 2.5rem 1.5rem;
        font-size: 0.95rem;
        span { opacity: 0.6; }
        a { color: vars.$gold; font-weight: 600; }
    }

    @media (max-width: 768px) {
        .service-page { padding-top: 110px; }
        .page-header .page-title { font-size: 2.3rem; }
        .service-content :global(h2) { font-size: 1.8rem; }
        .section-title { font-size: 2rem; }
        .header-actions {
            flex-direction: column;
            gap: 1rem;
            a { display: block; text-align: center; width: 100%; box-sizing: border-box; }
        }
    }
</style>
